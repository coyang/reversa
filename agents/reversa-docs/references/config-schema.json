{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reversa Docs Config",
  "description": "Configuration persisted in .reversa/documentation/.config.json after the /reversa-docs interview. Reused by subsequent runs and by isolated agents.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "projectName", "interview", "seed", "knowledgeSources"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema version. Increment when there is a breaking change."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 of when the interview was conducted."
    },
    "reversa": {
      "type": "object",
      "properties": {
        "version": { "type": "string" }
      }
    },
    "projectName": {
      "type": "string",
      "description": "Project name. Comes from soul.md if available, otherwise from the root folder name."
    },
    "interview": {
      "type": "object",
      "required": ["readerProfile", "depth", "visualStyle"],
      "properties": {
        "readerProfile": {
          "type": "string",
          "enum": ["new_dev", "stakeholder", "auditor", "other"]
        },
        "readerProfileFreeform": {
          "type": "string",
          "description": "Free text when readerProfile = other."
        },
        "depth": {
          "type": "string",
          "enum": ["overview", "full", "features_selection", "other"]
        },
        "depthFreeform": {
          "type": "string"
        },
        "selectedFeatures": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of chosen specs when depth = features_selection."
        },
        "visualStyle": {
          "type": "string",
          "enum": ["sober", "premium", "dense", "exploratory", "other"]
        },
        "visualStyleFreeform": {
          "type": "string"
        }
      }
    },
    "seed": {
      "type": "object",
      "required": ["hash", "source"],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "enum": ["soul.md", "project_name"]
        },
        "explicitOverride": {
          "type": ["string", "null"],
          "description": "Value passed via --seed=<value>, overrides calculated hash."
        }
      }
    },
    "knowledgeSources": {
      "type": "object"
    }
  }
}
